 #Plot function
def line_plot():
    wl = []
    yl=[]
    # Node locations
    n4=(r//2)*c
    for i in range(c):
        wl.append((2*i + 1)*w/(2*c))
    if (r//2)%2==0:
        for y in t_n[n4-1:n4-c-1:-1]:
            yl.append(y)
    if (r//2)%2!=0:
        for y in t_n[n4-c:n4:1]:
            yl.append(y)
                
    plt.plot(wl, yl, marker='o')
    plt.xlabel("Position (m)")
    plt.ylabel("Temperature (°C)")
    plt.title("Temperature Distribution")
    plt.grid(True)
    plt.show()

